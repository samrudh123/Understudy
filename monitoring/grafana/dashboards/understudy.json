          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(edge_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "instant": false,
          "range": true
