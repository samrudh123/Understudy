  "components": {
    "schemas": {
      "DecisionIn": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "merge"
            ],
            "title": "Decision"
          },
          "reviewer": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Reviewer"
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "paraphrases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paraphrases"
          },
          "merge_into": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merge Into"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reviewer"
        ],
        "title": "DecisionIn",
        "description": "A reviewer decision on one draft."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PromoteIn": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "PromoteIn",
        "description": "Make ``version`` the champion."
      },
      "RollbackIn": {
        "properties": {
          "to_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Version"
          }
        },
        "type": "object",
        "title": "RollbackIn",
        "description": "Roll the champion back (default: to the version it replaced)."
      },
      "RunIn": {
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "discover",
              "retrain",
              "full"
            ],
            "title": "Target"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": "manual (console)"
          }
        },
        "type": "object",
        "required": [
          "target"
        ],
        "title": "RunIn",
        "description": "Start a pipeline target."
      },
      "SimulateIn": {
        "properties": {
          "weeks": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[0-9,\\- ]+$",
            "title": "Weeks"
          },
          "teacher_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Teacher Rate",
            "default": 0.01
          }
        },
        "type": "object",
        "required": [
          "weeks"
        ],
        "title": "SimulateIn",
        "description": "Replay simulated weeks against the edge."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
