# Teacher: llama.cpp (CPU) behind Ray Serve. Weights are mounted at /app/models/gguf.
# Built for generic x86-64 with AVX2/FMA so the image runs on other machines (not -march=native).
FROM python:3.11-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git \
    && rm -rf /var/lib/apt/lists/*
ENV CMAKE_ARGS="-DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON"
RUN pip wheel --no-deps -w /wheels llama-cpp-python==0.3.36

FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 UNDERSTUDY_ROOT=/app \
    RAY_USAGE_STATS_ENABLED=0 RAY_AUTH_MODE=disabled
WORKDIR /app
COPY --from=build /wheels /wheels
COPY docker/requirements/teacher.txt /tmp/req.txt
RUN pip install /wheels/*.whl && pip install -r /tmp/req.txt
COPY pyproject.toml README.md params.yaml ./
COPY configs ./configs
COPY src ./src
RUN pip install --no-deps . && useradd -u 1000 -m app && mkdir -p models/gguf && chown -R app /app
USER app
EXPOSE 8000 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/teacher/health || exit 1
CMD ["python", "-m", "understudy.teacher.serve"]
