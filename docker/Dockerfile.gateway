FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 UNDERSTUDY_ROOT=/app
WORKDIR /app
COPY docker/requirements/gateway.txt /tmp/req.txt
RUN pip install -r /tmp/req.txt
COPY pyproject.toml README.md params.yaml ./
COPY configs ./configs
COPY src ./src
RUN pip install --no-deps . && useradd -u 1000 -m app
USER app
EXPOSE 8002
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health', timeout=2)" || exit 1
CMD ["python", "-m", "understudy.gateway.app"]
