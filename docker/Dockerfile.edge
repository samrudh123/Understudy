# Edge: FastAPI + ONNX Runtime student. Runs under a 1 CPU / 1 GB limit (docker-compose.yml).
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    UNDERSTUDY_ROOT=/app OMP_NUM_THREADS=1 MLFLOW_DISABLE_AGENT_HINT=1
WORKDIR /app
COPY docker/requirements/edge.txt /tmp/req.txt
RUN pip install -r /tmp/req.txt
COPY pyproject.toml README.md params.yaml ./
COPY configs ./configs
COPY src ./src
RUN pip install --no-deps . && useradd -u 1000 -m app \
    && mkdir -p data/querylogs models/edge_cache && chown -R app /app
USER app
EXPOSE 8001
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=2)" || exit 1
CMD ["python", "-m", "understudy.edge.app"]
