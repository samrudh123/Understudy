#!/usr/bin/env bash
# Continuous integration via DVC: after each commit, re-run whatever pipeline
# stages are out of date (DVC skips unchanged stages). Runs in the background and
# logs to reports/ci/. Disable with UNDERSTUDY_CI=0.
[ "${UNDERSTUDY_CI:-1}" = "0" ] && exit 0
cd "$(git rev-parse --show-toplevel)"
nohup scripts/ci.sh > /dev/null 2>&1 &
